 (setf (show-page? newobj) nil) (setf (sheet-id newobj) nil) (setf (page-mode newobj) nil) newobj) (quote g) 24 2 nil)) t nil nil nil (quote nil)))) (when (fboundp (quote set-active)) (set-active box nil)) box) (let ((box (om-load-boxcomment "Additional inputs of pitch-profile-hr allow to
further shape the a profile. 
The argument map expects a function (or
abstraction in lambda mode) that
processes every value in the profile. Some
functions are already predefined for
convenience (menu Cluster Rules - profile -
transformations). For example,
mp-add-offset adds an offset to every
profile value, resulting in a transposition
here. Try changing the argument of this
function to see that effect.
Only a few basic cases are predefined,
because you can define your own functions
or abstractions that do that. The example
also shows an abstraction that does
exactly the same as mp-add-offset
(although you need to open it to change
the value), and a code box that behaves
exactly like the predefined function.
The argument transform of pitch-profile-hr
is similar, but instead of modifying
individual profile values it changes the
profile as a whole (expects and returns a
list of numbers)." (om-make-point 344 360) (quote "Additional inputs of pitch-profile-hr allow to further $shape the a profile. $$The argument map expects a function (or abstraction $in lambda mode) that processes every value in the $profile. Some functions are already predefined for$convenience (menu Cluster Rules - profile - $transformations). For example, mp-add-offset adds $an offset to every profile value, resulting in a $transposition here. Try changing the argument of this$function to see that effect.$$Only a few basic cases are predefined, because you $can define your own functions or abstractions that $do that. The example also shows an abstraction that $does exactly the same as mp-add-offset (although $you need to open it to change the value), and a code $box that behaves exactly like the predefined function.$$The argument transform of pitch-profile-hr is similar, $but instead of modifying individual profile values it $changes the profile as a whole (expects and returns a$list of numbers).") "" (om-make-point 839 94) nil (om-make-color 0 0 0) (om-make-font "Verdana" 12 :family "Verdana" :style (quote (:plain)) :mode (quote nil))))) (when (fboundp (quote set-active)) (set-active box nil)) box) (let ((box (om-load-editor-box1 "POP-UP-MENU" (quote pop-up-menu) (quote ((om-load-inputfun (quote input-funbox) "list of choices" "items" (list "mp-add-offset" "Abs1" "code-box")) (om-load-inputfun (quote input-funbox) "a function or box in lambda mode" "action" nil))) (om-make-point 62 399) (om-make-point 243 45) (let ((rep (om-make-dialog-item (quote pop-up-menu) (om-make-point 1 1) (om-make-point 223 26) "untitled" :range (quote ("mp-add-offset" "Abs1" "code-box"))))) (om-set-selected-item-index rep (quote 0)) rep) "x" nil (pairlis (quote (winpos winsize)) (list (om-make-point 10 40) (om-make-point 335 275))) nil nil nil nil (quote nil)))) (when (fboundp (quote set-active)) (set-active box nil)) box) (let ((box (om-load-boxcall (quote genfun) "OM=" (quote om=) (qu